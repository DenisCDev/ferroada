TARGET_URL=http://localhost:8080
RUST_LOG=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
REPLICA_COUNT=1
# RISK_SESSION_COOKIE=session
# RISK_API_KEY_HEADER=X-API-Key
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem
DASHBOARD_PORT=9000
DASHBOARD_BIND=127.0.0.1

# Security Headers (v0.3)
SECURITY_HEADERS=true
# CSP_POLICY=default-src 'self'              # OFF by default — breaks CDNs/inline scripts
# PERMISSIONS_POLICY=camera=(), microphone=() # OFF by default — breaks video/map apps

# Method & Size Restrictions (v0.3)
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
MAX_BODY_SIZE=65536
WAF_MAX_IN_FLIGHT_BYTES=67108864
MAX_URI_LENGTH=8192

# Host Validation (v0.3) — DNS rebinding protection
# ALLOWED_HOSTS=meusite.com,www.meusite.com

# DLP — Data Loss Prevention
DLP_ENABLED=true
DLP_MAX_RESPONSE_BYTES=1048576
DLP_MAX_IN_FLIGHT_BYTES=67108864

# Proteção antes do parser HTTP
CONNECTION_RATE_MAX=60
CONNECTION_RATE_WINDOW=1
GLOBAL_CONNECTION_RATE_MAX=10000
MAX_ACTIVE_CONNECTIONS=10000

# HTTPS Enforcement (v0.3)
FORCE_HTTPS=false
# HTTPS_REDIRECT_HOST=www.meusite.com

# Dashboard Auth — a tela envia o token como Bearer. Não use token na query.
# FERROADA_PRODUCTION=true torna o token obrigatório mesmo em 127.0.0.1.
# O HTML do dashboard continua público (formulário de token); métricas exigem Bearer.
# FERROADA_PRODUCTION=true
# DASHBOARD_TOKEN=change-this-dashboard-token
# DASHBOARD_CORS=http://localhost:3100
