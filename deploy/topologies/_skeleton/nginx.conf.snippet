# Nginx na frente do Ferroada. Não publique :443 no Ferroada ao mesmo tempo.
# Exige PROXY_PROTOCOL=true no env (.env.caddy.example). Sem a flag o prefixo é recusado.
# TRUSTED_PROXIES deve incluir o endereço deste Nginx.
# Substitua {{PUBLIC_HOST}} e recarregue o nginx.

server {
    listen 80;
    listen 443 ssl;
    server_name {{PUBLIC_HOST}};
    # ssl_certificate     /etc/letsencrypt/live/{{PUBLIC_HOST}}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/{{PUBLIC_HOST}}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_protocol on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
