# Pack de produção Ferroada 0.6.0. Copie para .env e substitua os placeholders.
# Gere o token: openssl rand -hex 32
# Não commite o .env.

PUBLIC_HOST={{PUBLIC_HOST}}
ORIGIN=http://app:8080

DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9000
DASHBOARD_TOKEN=substitua-por-32-bytes-hex

ALLOWED_HOSTS={{PUBLIC_HOST}},www.{{PUBLIC_HOST}}
WAF_REQUIRE_COMPLETE_PATHS=/api/payment,/api/admin,/auth,/login
WAF_PROFILE=generic

# Snapshot Cloudflare 2026-09-08 (deploy/cidrs/cloudflare.txt). Não deixe vazio neste pack. Fastly/Akamai: substitua pelo ficheiro correspondente.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

FORCE_HTTPS=true
DLP_ENABLED=true
SECURITY_HEADERS=true
RUST_LOG=info

# TLS no Ferroada. Não use junto com Caddy na mesma :443.
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem
