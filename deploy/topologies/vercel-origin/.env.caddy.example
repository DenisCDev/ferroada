# Caminho Caddy na frente. Copie para .env.caddy.
# Não use com docker-compose.yml (Ferroada a publicar 443).

PUBLIC_HOST={{PUBLIC_HOST}}
ORIGIN=https://SEU_PROJECTO.vercel.app

DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9000
DASHBOARD_TOKEN=substitua-por-32-bytes-hex

ALLOWED_HOSTS={{PUBLIC_HOST}}
WAF_REQUIRE_COMPLETE_PATHS=/api/,/auth/
WAF_PROFILE=generic

# Caddy neste Compose tem IP fixo 172.28.0.2. Sem isso o X-Forwarded-Proto é ignorado.
TRUSTED_PROXIES=172.28.0.2/32

FORCE_HTTPS=false
DLP_ENABLED=true
DLP_ACTION=monitor
ORIGIN_SECRET_HEADER=x-vercel-protection-bypass
ORIGIN_SECRET=substitua-pelo-token-de-bypass
SECURITY_HEADERS=true
RUST_LOG=info

# Hop TCP (Caddy/nginx/HAProxy/NLB) prefixa PROXY v2. Sem o prefixo a conexão é recusada.
PROXY_PROTOCOL=true
