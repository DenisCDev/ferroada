# Caddy termina TLS na frente do Ferroada.
# Não publique :443 no Ferroada ao mesmo tempo (nem 443:3443 no Compose).
# Docker: reverse_proxy ferroada:3000 com proxy_protocol v2 (já abaixo).
# systemd no host: o mesmo Caddyfile apontando a 127.0.0.1:3000.
# Env: PROXY_PROTOCOL=true (.env.caddy.example). Sem a flag o prefixo é recusado.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128.
# Substitua {{PUBLIC_HOST}} antes de subir.

{{PUBLIC_HOST}} {
    encode gzip
    reverse_proxy ferroada:3000 {
        transport http {
            proxy_protocol v2
        }
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}
