# Pack de produção Ferroada 0.6.0. Copie para .env e substitua os placeholders.
# Gere o token: openssl rand -hex 32
# Não commite o .env.

PUBLIC_HOST={{PUBLIC_HOST}}
ORIGIN=http://app:8080

DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9000
DASHBOARD_TOKEN=substitua-por-32-bytes-hex

ALLOWED_HOSTS={{PUBLIC_HOST}}
WAF_REQUIRE_COMPLETE_PATHS=/api/,/auth/,/graphql
WAF_PROFILE=generic

# Sem CDN: vazio. O JS noutro sítio não passa aqui.
TRUSTED_PROXIES=

FORCE_HTTPS=false
DLP_ENABLED=true
SECURITY_HEADERS=true
RUST_LOG=info

# TLS no Ferroada. Não use junto com Caddy na mesma :443.
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem
