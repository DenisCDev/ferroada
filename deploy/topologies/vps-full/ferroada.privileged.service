[Unit]
Description=Ferroada origin gateway
Documentation=https://github.com/DenisCDev/ferroada
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ferroada
Group=ferroada
WorkingDirectory=/etc/ferroada
EnvironmentFile=/etc/ferroada/env
Environment=PROXY_LISTEN=0.0.0.0:80
Environment=TLS_LISTEN=0.0.0.0:443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/ferroada
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/ferroada
# :80/:443 só com o par knob + CAP_NET_BIND_SERVICE. O binário não é setuid.
# Não use este unit com Caddy a publicar 80/443 no mesmo host.

[Install]
WantedBy=multi-user.target
