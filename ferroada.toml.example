# Ferroada Multi-Site Configuration
#
# Packs de produção (dashboard em loopback, sem publicar a porta 9000):
#   deploy/topologies/
#
# Quando este arquivo existe, o Ferroada roda em modo multi-site:
# cada request e roteado para o backend correto pelo Host header.
#
# Se preferir modo single-site, delete este arquivo e use TARGET_URL no .env.

# Backend padrao para hosts nao configurados (opcional).
# Se nao definido, requests com Host desconhecido recebem 421.
# default_backend = "http://fallback:8080"

# L1 CRS (sidecar Coraza). L0 regex continua sempre ligado.
# executing_paranoia pode ser maior que blocking_paranoia: as regras extras
# correm e pontuam em observação, mas só o blocking decide o 403.
# shadow = true avalia L1, grava rule ID + score, e NÃO bloqueia.
# Exclusão por site (l1.exclude), rota (prefix), parâmetro e content-type.
# [waf.l1]
# blocking_paranoia = 1
# executing_paranoia = 4
# shadow = true
# anomaly_score_threshold = 5
# [[waf.l1.exclusions]]
# content_types = ["application/octet-stream"]

# Matriz de protocolo. inspect = suportado (L0 faz o que já faz).
# Não suportado: deny | monitor | bypass-explicit | route-to-quarantine
# route-to-quarantine (v1) = 403 + evento quarantine; sem origin honeypot.
# Linhas omitidas usam o default. multipart/brotli/unknown_encoding/
# unknown_content_type omitidos = deny em require_complete, monitor no resto.
# Não existe unknown = "deny" ambíguo.
[protocols]
http_1_0 = "deny"
http_1_1 = "inspect"
http_2 = "inspect"
http_3 = "deny"
websocket = "bypass-explicit"
grpc = "deny"
json = "inspect"
gzip_deflate = "inspect"
sse = "inspect"
unknown_http_version = "deny"
unknown_upgrade = "deny"

[[sites]]
hosts = ["meusite.com", "www.meusite.com"]
backend = "http://backend-a:8080"
waf_profile = "wordpress"
require_complete_waf_inspection = ["/api/payment", "/api/admin/"]
# l1.shadow = true
# l1.blocking_paranoia = 1
# l1.executing_paranoia = 4
# [[sites.l1.exclusions]]
# prefix = "/login"
# [[sites.l1.exclusions]]
# parameters = ["password", "token"]

# on_truncated / on_parse_error por prefixo. require_complete_waf_inspection
# acima já significa on_truncated=deny e on_parse_error=deny nesses paths.
# max_decoded_body só em require_complete: os três tetos (fio, texto, inflate)
# usam este número. Sem require_complete o processo recusa o TOML no load.
# [[sites.routes]]
# prefix = "/api/payment"
# inspection.require_complete = true
# inspection.on_truncated = "deny"
# inspection.on_parse_error = "deny"
# inspection.max_decoded_body = "256KiB"

[[sites]]
hosts = ["api.meusite.com"]
backend = "http://backend-b:3000"
# OpenAPI 3.0/3.1 (opt-in). Sem spec o proxy permanece Level 1.
# Compilado no load. unknown_endpoint: observe (default do pack) ou deny.
# Sem a chave, rotas require_complete negam endpoint desconhecido.
# unknown method e content-type não listado: sempre deny.
# extra field no JSON: deny, salvo additionalProperties: true no spec.
# openapi = { spec = "./openapi.yaml", unknown_endpoint = "observe" }
# JWT/JWKS (opt-in). Sem bloco jwt o site continua Level 1, sem Authorization.
# alg default: RS256 e ES256. none é recusado. HS* só com algorithms explícito
# e hmac_secret_env. iss e aud obrigatórios. Bindings declarativos.
# jwt = { jwks = "https://auth.exemplo.com/.well-known/jwks.json", issuer = "https://auth.exemplo.com", audience = "api.meusite.com", paths = ["/accounts/{account_id}"], bindings = ["jwt.sub == path.account_id", "jwt.tenant_id == body.tenant_id"] }
# GraphQL AST (opt-in). Sem bloco o POST /graphql continua HTTP/WAF/OpenAPI.
# Limites no AST, não regex. Introspection default off em produção.
# Quota usa jwt.sub se o site tem jwt, senão o IP. Parse falhou = ParseError da rota.
# graphql = { max_depth = 8, max_complexity = 200, max_aliases = 15, max_fragments = 10, max_operations = 5, introspection = false, persisted_only = false, persisted_queries = ["<sha256 hex>"], quota = 1000 }
# gRPC (opt-in). Sem bloco o tráfego application/grpc segue a matriz (default deny).
# Descriptor = FileDescriptorSet compilado no load. Método fora da allowlist → 403.
# Reflection (ServerReflectionInfo) nasce desligada. Parse falhou = ParseError da rota.
# max_message_bytes é o payload da message (o frame no fio tem +5 bytes); 64KiB de
# message pede max_decoded_body/spool acima de 64KiB, senão o teto HTTP corta antes.
# grpc = { descriptor = "./api.pb", allow = ["pkg.Service/Method"], max_message_bytes = "64KiB", reflection = false }
# DLP por campo JSON (opt-in). Sem isto o site continua o DLP de blob
# (CPF/CNPJ com dígito, cartão com Luhn, Bearer). Path tipo $.user.cpf.
# [[sites.dlp.fields]]
# path = "$.user.cpf"
# detector = "cpf"
# [[sites.dlp.fields]]
# path = "$.company.cnpj"
# detector = "cnpj"
# [[sites.routes]]
# prefix = "/api/pay"
# [[sites.routes.dlp.fields]]
# path = "$.card"
# detector = "card"

# [[sites]]
# hosts = ["outrosite.com", "www.outrosite.com"]
# backend = "https://backend-c:443"
