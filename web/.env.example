FERROADA_URL=http://127.0.0.1:9000
# Mesmo valor de DASHBOARD_TOKEN.
FERROADA_TOKEN=change-me
# Token separado que o visitante informa para acessar métricas pelo painel Next.
FERROADA_WEB_TOKEN=change-this-browser-access-token
# Só true para screenshot/demo. Em produção deixe false — senão o painel inventa tráfego.
FERROADA_ALLOW_DEMO=false
